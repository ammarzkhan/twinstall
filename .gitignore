bin/
obj/
*.user
*.suo
.vs/

# Release output from scripts/publish.ps1
artifacts/
publish/
publish-*/

# Build outputs
*.msix
*.msixbundle
*.appx
*.appxbundle
*.pri

# Never commit a signing certificate or key
*.pfx
*.snk
*.p12

# Generated icons — Twinstall derives these from the user's own installed app at run
# time, and shipping third-party artwork in the repo is exactly what we're avoiding.
*.ico

# ...with one exception: Twinstall's OWN mark. The rule above exists to keep other
# vendors' logos out of the repository, not our own. Generated by scripts/make-logo.ps1
# from assets/logo.svg, and needed by the build (ApplicationIcon) and by MSIX.
!assets/twinstall.ico
