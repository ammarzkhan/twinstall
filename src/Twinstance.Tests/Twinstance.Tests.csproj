<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A console app, not a test-framework project, on purpose:

      * `dotnet run` works with no package restore, so CI has nothing to install and
        nothing to go stale.
      * The same source compiles under mono, so the logic can be checked on a non-Windows
        machine before it ever reaches a Windows runner.
      * Exit code is the result. No adapter, no reporter, no XML.

    If this grows past a few hundred assertions, move to xUnit. It hasn't yet.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Twinstance.Tests</AssemblyName>
    <RootNamespace>Twinstance.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twinstance.Core\Twinstance.Core.csproj" />
  </ItemGroup>

</Project>
