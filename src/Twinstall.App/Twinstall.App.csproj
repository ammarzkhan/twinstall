<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One executable, four jobs: protocol router, instance launcher, icon watcher and
    management UI. They are one binary rather than several because the MSIX manifest
    declares a single Executable, and because a protocol handler that is also the app the
    user configured is easier to reason about than a pair that must stay in step.

    Startup cost of the UI is not paid by the routing path: Program.Main dispatches on
    argv before touching a WinForms type, so the assemblies are never loaded when a
    callback arrives. That matters - routing sits between a browser sign-in and the app.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Twinstall</AssemblyName>
    <RootNamespace>Twinstall.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      Same reason as Twinstall.Platform: System.Drawing.Common is Windows-only by design.

      The rest are suppressed only in this project, and only because WinForms ownership
      semantics make them false here. They stay enabled everywhere else.

        CA1303  Localisable strings. This is a single-language desktop UI with no resource
                table and no plan for one; routing every button caption through .resx would
                be ceremony, not translation.
        CA2213  Control fields "never disposed". Every one of them is added to Controls, and
                a Form disposes its Controls collection. The analyser cannot see that
                ownership transfer. If you add a field that is NOT added to Controls -
                a Font, a Bitmap, a Timer - dispose it yourself; this suppression will not
                warn you.
        CA2000  Application.Run(new MainForm()) - Run disposes the form when the message
                loop ends.
        CA1308  ProgIdFor lowercases a URL scheme. Schemes are case-insensitive and lowercase
                by convention (RFC 3986); this is normalisation to the correct case, not the
                security-sensitive shortcut the rule is aimed at.
    -->
    <NoWarn>$(NoWarn);CA1416;CA1303;CA2213;CA2000;CA1308</NoWarn>

    <!--
      NEVER turn this on. Measured on 7 Aug 2026: publishing with
      EnableCompressionInSingleFile=true produced a binary that Bitdefender quarantined
      *during the build*, mid-bundle, every attempt. The same publish with compression off
      succeeded, survived, and ran.

      The reason is structural, not a fluke. A compressed payload embedded in an executable
      and expanded at run time is the defining shape of a packer or dropper, and that is
      what the heuristic is for. Twinstall is already an unsigned protocol handler that
      enumerates process command lines; it does not need to also look packed. Shipping a
      build users cannot install is worse than shipping a larger one.

      Prefer the framework-dependent output (0.7 MB) for distribution anyway - see
      scripts/publish.ps1 and docs/BUILDING.md.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Cosmetic, but it is what shows in the file's Details tab and in AV prompts. -->
    <Product>Twinstall</Product>
    <AssemblyTitle>Twinstall</AssemblyTitle>
    <Description>Run a second, separately signed-in copy of a desktop app.</Description>
    <Copyright>Copyright (c) 2026 ammarzkhan</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twinstall.Core\Twinstall.Core.csproj" />
    <ProjectReference Include="..\Twinstall.Platform\Twinstall.Platform.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Twinstall's own mark, generated by scripts/make-logo.ps1 from assets/logo.svg. -->
    <ApplicationIcon>..\..\assets\twinstall.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Convenience list only; detection works identically for apps that aren't in it. -->
    <None Include="..\..\presets\apps.json" Link="presets\apps.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- Embedded so the window icon keeps every size. ExtractAssociatedIcon would give a
         single 32px frame, which looks soft on a high-DPI taskbar. -->
    <EmbeddedResource Include="..\..\assets\twinstall.ico" LogicalName="Twinstall.App.logo.ico" />

    <!-- Also embedded, so a single-file build really is a single file. It stays copied
         beside the exe as well, because that copy is editable and the embedded one is not. -->
    <EmbeddedResource Include="..\..\presets\apps.json" LogicalName="Twinstall.App.presets.json" />
  </ItemGroup>

</Project>
