<?xml version="1.0" encoding="utf-8"?>
<!--
  Sketch only. The Protocol declarations below are the whole reason to test certification
  early: declaring another vendor's scheme is mechanically supported and is the sanctioned
  alternative to writing HKCU\Software\Classes directly, but Store policy guidance on doing
  so is silent. Submit a build with ONE of these before writing the rest of the product.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity Name="REPLACE.Twinstance" Publisher="CN=REPLACE" Version="0.1.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Twinstance</DisplayName>
    <PublisherDisplayName>REPLACE</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources><Resource Language="en-us" /></Resources>

  <Capabilities>
    <!-- required to enumerate other processes' command lines and P/Invoke user32 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="Twinstance" Executable="Twinstance.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Twinstance"
        Description="Run a second, separately signed-in copy of your desktop apps"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent" />

      <Extensions>
        <!-- one entry per app whose sign-in callbacks Twinstance routes -->
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="slack" Parameters="&quot;%1&quot;" />
        </uap3:Extension>
        <!--
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="discord" Parameters="&quot;%1&quot;" />
        </uap3:Extension>
        -->
      </Extensions>
    </Application>
  </Applications>
</Package>
